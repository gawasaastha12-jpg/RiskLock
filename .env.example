# RiskLock Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed

PORT=8000
ENVIRONMENT=production
DEBUG=false

# CORS & Frontend Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173
FRONTEND_URL=https://risklock-frontend.onrender.com

# Model Artifact Locations
MODEL_PATH=models/baseline_xgboost.json
CALIBRATOR_PATH=models/calibrated_platt_scaler.joblib
LOGS_DIR=logs

# Cryptographic Session & Token Configuration
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change_this_to_a_64_character_random_hex_secret_in_production
SESSION_TTL_SECONDS=7200

# Authentication & Access Control Security
# Set to 'false' in live production to disable all hardcoded/demo credentials
ENABLE_DEMO_ACCOUNTS=false
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=change_this_to_a_secure_password_in_production

# Rate Limiting & Protection
RATE_LIMIT_ASSESS=60
AUTH_RATE_LIMIT_PER_MINUTE=5
